{
	"name": "@toreda/adt",
	"version": "1.0.0",
	"description": "Generic, iterable abstract data types for TypeScript: Stack, Queue, Circular Queue, Priority Queue, Linked List, and Object Pool. Queryable and serializable.",
	"public": true,
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"scripts": {
		"lint": "pnpm eslint ./src/** --quiet",
		"lint:nofix": "pnpm lint",
		"lint:fix": "pnpm eslint src/**/*.{js,ts,tsx} --quiet --fix",
		"make:docs": "pnpm typedoc docs --categorizeByGroup false --entryPoints ./src/index.ts",
		"build": "pnpm build:prod",
		"build:prod": "pnpm gulp --prod",
		"build:dev": "pnpm gulp --dev",
		"test:ci": "cross-env COVERAGE=full jest --ci --coverage --maxWorkers=50% --reporters=default --reporters=jest-junit",
		"test:fast": "cross-env COVERAGE=summary jest --bail --coverage",
		"test:silent": "pnpm jest --coverage=false --maxWorkers=50% --silent --verbose=false"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toreda/adt.git"
	},
	"keywords": [
		"adt",
		"abstract-data-types",
		"data-structures",
		"collections",
		"typescript",
		"generics",
		"iterable",
		"iterator",
		"stack",
		"queue",
		"circular-queue",
		"ring-buffer",
		"priority-queue",
		"heap",
		"linked-list",
		"object-pool",
		"toreda"
	],
	"author": "Toreda, Inc.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/toreda/adt/issues"
	},
	"prettier": "@toreda/prettier-config",
	"homepage": "https://github.com/toreda/adt#readme",
	"devDependencies": {
		"@jest/types": "^30.5.1",
		"@swc/core": "^1.16.2",
		"@swc/jest": "^0.2.39",
		"@toreda/build-tools": "^0.8.0",
		"@toreda/eslint-config": "^4.0.0",
		"@toreda/log": "^1.0.0",
		"@toreda/prettier-config": "^2.0.0",
		"@types/eslint": "^9.6.1",
		"@types/gulp": "^4.0.18",
		"@types/jest": "^30.0.0",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.2",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@typescript-eslint/typescript-estree": "^8.70.0",
		"cross-env": "^10.1.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"jest": "^30.5.2",
		"jest-canvas-mock": "^2.5.2",
		"jest-environment-jsdom": "^30.2.0",
		"jsdom": "^30.1.0",
		"prettier": "^3.9.8",
		"@toreda/shared-types": "^3.0.0",
		"ts-node": "^10.9.2",
		"typedoc": "^0.28.20",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"@toreda/log": "^1.0.0",
		"@toreda/shared-types": "^3.0.0"
	},
	"dependencies": {
	}
}
